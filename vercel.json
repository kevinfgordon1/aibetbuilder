    },
    "api/desk-protect-sweep.js": {
      "maxDuration": 15
    },
    "api/soccer-pm-no.js": {
      "maxDuration": 20
    },
    "api/betstamp-stream.js": {
      "maxDuration": 300
    },
    "api/polymarket-stream.js": {
      "maxDuration": 300
    },
    "api/polymarket-board.js": {
