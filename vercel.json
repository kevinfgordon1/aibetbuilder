      "dest": "/md/ev-bets.md",
      "headers": { "Content-Type": "text/markdown; charset=utf-8", "Vary": "Accept", "Cache-Control": "public, max-age=0, must-revalidate" }
    },
    {
      "src": "^/(?!api(?:/|$)|assets(?:/|$)|md(?:/|$)|s(?:/|$))(?!.*\\.).*$",
      "has": [{ "type": "header", "key": "accept", "value": ".*text/markdown.*" }],
      "status": 404,
      "dest": "/api/agent-markdown-404",
      "headers": { "Content-Type": "text/markdown; charset=utf-8", "Vary": "Accept" }
    }
  ],
  "crons": [
    {
      "path": "/api/fetch-odds",
      "schedule": "*/5 11-23 * * *"
    },
    {
      "path": "/api/fetch-odds",
      "schedule": "*/5 0-6 * * *"
    },
    {
      "path": "/api/fetch-odds",
      "schedule": "0 7-10 * * *"
    },
    {
      "path": "/api/fetch-futures",
      "schedule": "5-55/10 12-23 * * *"
    },
    {
      "path": "/api/fetch-futures",
      "schedule": "5-55/10 0-3 * * *"
    },
    {
      "path": "/api/fetch-futures",
      "schedule": "5 4,8 * * *"
    },
    {
      "path": "/api/fetch-player-props",
      "schedule": "2-57/5 * * * *"
    },
    {
      "path": "/api/root-for?cron=needle",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/combo-auto-settle",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/combo-leg-fairs?cron=1",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/underdog-health",
      "schedule": "20 13,17,21 * * *"
    }
  ],
  "functions": {
    "api/fetch-odds.js": {
      "maxDuration": 60
    },
    "api/fetch-player-props.js": {
      "maxDuration": 60
    },
    "api/player-td-board.js": {
      "maxDuration": 60
    },
    "api/scan-ev-parlays.js": {
