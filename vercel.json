{
  "routes": [
    {
      "src": "^/(?:index\\.html)?$",
      "has": [{ "type": "header", "key": "accept", "value": ".*text/markdown.*" }],
      "dest": "/md/index.md",
      "headers": { "Content-Type": "text/markdown; charset=utf-8", "Vary": "Accept", "Cache-Control": "public, max-age=0, must-revalidate" }
    },
    {
      "src": "^/app/?$",
      "has": [{ "type": "header", "key": "accept", "value": ".*text/markdown.*" }],
      "dest": "/md/app.md",
      "headers": { "Content-Type": "text/markdown; charset=utf-8", "Vary": "Accept", "Cache-Control": "public, max-age=0, must-revalidate" }
    },
    {
      "src": "^/learn(?:\\.html)?/?$",
      "has": [{ "type": "header", "key": "accept", "value": ".*text/markdown.*" }],
