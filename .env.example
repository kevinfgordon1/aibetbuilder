# Supabase (existing)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# Combo Locks allowlist — UI / route gate only (RLS still scopes combo_* rows).
# Comma-separated Google emails and/or Supabase auth uids.
# Kevin's Google account (kev120909@gmail.com) is always included, even if this
# var is empty. Set this in Vercel so testers can see Combo Locks without a code change.
#
# Example:
# VITE_COMBO_LOCKS_ALLOWLIST=kev120909@gmail.com,another@gmail.com,00000000-0000-0000-0000-000000000000
VITE_COMBO_LOCKS_ALLOWLIST=

# Underdog Predict (Betstamp 196) — New Odds Board column + Promo true-odds overlay.
# Gate is the signed-in Google/Supabase email (case-insensitive), same pattern as
# Combo Locks. Kevin (kev120909@gmail.com) and Kenneth (kmguido97@gmail.com) are
# always included in code. Add more emails or auth uids here without a code
# change. If you rely on the env-only path, include Kenneth:
# VITE_UNDERDOG_PREDICT_ALLOWLIST=kev120909@gmail.com,kmguido97@gmail.com
# UNDERDOG_PREDICT_ALLOWLIST is also read.
#
# /api/betstamp-markets is anon (no JWT). 196 stays on the server allowlist so
# Kevin's / Kenneth's client can request it. Default / omitted book_ids and
# other clients do not fetch 196. Anyone who spoofs ?book_ids=196 can still
# pull the raw snapshot; the UI will not show the column or overlay.
#
# Example:
# VITE_UNDERDOG_PREDICT_ALLOWLIST=kev120909@gmail.com,kmguido97@gmail.com
VITE_UNDERDOG_PREDICT_ALLOWLIST=

# Betstamp Pro (server-only). Powers Kevin's New Odds Board (#new-odds-board).
# Never prefix with VITE_ — the browser talks to /api/betstamp-markets and
# /api/betstamp-stream, which attach X-API-KEY on the server. Set the same
# name in Vercel (Production + Preview + Development).
# BETSTAMP_API_KEY=

# Optional — hours ahead of now for Betstamp /fixtures and /markets (default 240).
# Without this, those endpoints only return roughly ±24h, which drops next-week
# NFL/NCAAF slates. Override per request with ?timedelta=.
# BETSTAMP_TIMEDELTA=

# Optional — New Odds Board LIVE presence-reconcile interval (ms). Client-only.
# Default is 10000 (src/betstampLive.js BETSTAMP_LIVE_RECONCILE_MS). Snapshot
# listing is availability truth vs SSE silence. Clamp is 10000–60000.
# VITE_BETSTAMP_LIVE_RECONCILE_MS=

# Optional — how long a live quote can be missing from REST before OFF (ms).
# Clock is last-confirmed / last-seen, not Betstamp updated_at. Default 25000.
# Clamp is 10000–60000 (same resolver as the reconcile interval).
# VITE_BETSTAMP_RECONCILE_CLEAR_GRACE_MS=

# Optional — Promo rest-of-book (display only). Kalshi + Polymarket are public/keyless.
# ProphetX / Novig stay top-of-book (Odds API bet_limit) until these are set in Vercel.
# PROPHETX_API_KEY=
# PROPHETX_ACCESS_KEY=
# PROPHETX_SECRET_KEY=
# PROPHETX_API_BASE=https://cash.api.prophetx.co/partner
# NOVIG_CLIENT_ID=
# NOVIG_CLIENT_SECRET=
# NOVIG_API_BASE=https://api.novig.us

# Combo Locks Probe (POST /api/combo-probe) — RSA-PSS, same names as Railway combo-worker.
# kalshi-games.js stays keyless. Probe creates a real RFQ at the lock cap, waits ~4s,
# returns best maker NO bid, then DELETE the RFQ. It never accept/confirms a quote.
# Add these in the Vercel project env (Production + Preview + Development). Do not
# prefix with VITE_ — they are server-only secrets. Do not invent keys here.
#
# KALSHI_KEY_ID=
# Kalshi_combo_key=
# # or, if the worker key is stored under the generic name:
# # KALSHI_PRIVATE_KEY=
#
# Probe owner-gate uses the signed-in Supabase JWT (Authorization: Bearer).
# Server verifies with:
#   SUPABASE_URL  (or VITE_SUPABASE_URL)
#   SUPABASE_ANON_KEY  (or VITE_SUPABASE_ANON_KEY)
# Same Combo Locks allowlist as the UI (Kevin + VITE_COMBO_LOCKS_ALLOWLIST).
