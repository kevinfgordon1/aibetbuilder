# Supabase (existing)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# Combo Locks allowlist — UI / route gate only (RLS still scopes combo_* rows).
# Comma-separated Google emails and/or Supabase auth uids.
# Kevin's Google account (kev120909@gmail.com) is always included, even if this
# var is empty. Set this in Vercel so testers can see Combo Locks without a code change.
#
# Example:
# VITE_COMBO_LOCKS_ALLOWLIST=kev120909@gmail.com,another@gmail.com,00000000-0000-0000-0000-000000000000
VITE_COMBO_LOCKS_ALLOWLIST=

# Optional — Promo rest-of-book (display only). Kalshi + Polymarket are public/keyless.
# ProphetX / Novig stay top-of-book (Odds API bet_limit) until these are set in Vercel.
# PROPHETX_API_KEY=
# PROPHETX_ACCESS_KEY=
# PROPHETX_SECRET_KEY=
# PROPHETX_API_BASE=https://cash.api.prophetx.co/partner
# NOVIG_CLIENT_ID=
# NOVIG_CLIENT_SECRET=
# NOVIG_API_BASE=https://api.novig.us

# Combo Locks Probe (POST /api/combo-probe) — RSA-PSS, same names as Railway combo-worker.
# kalshi-games.js stays keyless. Probe creates a real RFQ at the lock cap, waits ~4s,
# returns best maker NO bid, then DELETE the RFQ. It never accept/confirms a quote.
# Add these in the Vercel project env (Production + Preview + Development). Do not
# prefix with VITE_ — they are server-only secrets. Do not invent keys here.
#
# KALSHI_KEY_ID=
# Kalshi_combo_key=
# # or, if the worker key is stored under the generic name:
# # KALSHI_PRIVATE_KEY=
#
# Probe owner-gate uses the signed-in Supabase JWT (Authorization: Bearer).
# Server verifies with:
#   SUPABASE_URL  (or VITE_SUPABASE_URL)
#   SUPABASE_ANON_KEY  (or VITE_SUPABASE_ANON_KEY)
# Same Combo Locks allowlist as the UI (Kevin + VITE_COMBO_LOCKS_ALLOWLIST).
